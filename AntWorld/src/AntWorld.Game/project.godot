; AntWorld — Godot 4 .NET. Open this file in the .NET editor.
config_version=5

[application]
config/name="AntWorld"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
config/description="Ecossistema procedural de formigas. Observe a vida encontrar seus caminhos."

[display]
window/size/mode=0
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="AntWorld.Game"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.045, 0.065, 0.08, 1)
